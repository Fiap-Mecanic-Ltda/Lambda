<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- dotnet8 e o runtime gerenciado da AWS Lambda; a aplicacao principal
         roda em .NET 9, mas a funcao nao referencia os projetos dela - o
         contrato entre as duas e o banco e a chave JWT. -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AWSProjectType>Lambda</AWSProjectType>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.Core" Version="2.2.0" />
    <PackageReference Include="Amazon.Lambda.APIGatewayEvents" Version="2.7.0" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" Version="2.4.3" />
    <!-- PasswordHasher: mesmo algoritmo do ASP.NET Core Identity usado pela
         API, para validar os hashes ja gravados em AspNetUsers. -->
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="8.0.11" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
  </ItemGroup>

</Project>
